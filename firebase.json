{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "hosting/public",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/.well-known/apple-app-site-association",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/join/**",
        "destination": "/join.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "theboringbuilders-foqui",
          "appId": "1:486004582512:android:d85d67522d975dd88a6cb5",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "theboringbuilders-foqui",
          "appId": "1:486004582512:ios:325707ecbf4178998a6cb5",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "theboringbuilders-foqui",
          "configurations": {
            "android": "1:486004582512:android:d85d67522d975dd88a6cb5",
            "ios": "1:486004582512:ios:325707ecbf4178998a6cb5"
          }
        }
      }
    }
  }
}
