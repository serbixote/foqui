---
import Base from "../layouts/Base.astro";

const description = "This page isn’t on Foqui.";
---

<Base title="Page not found — Foqui" description={description}>
  <main id="content" class="welcome missing">
    <img src="/images/foqui.webp" alt="" width="1200" height="900" />
    <h1>This page isn’t here.</h1>
    <p>The address is off, or this session link has ended.</p>
    <a class="button" href="/">Back to Foqui</a>
  </main>
</Base>
